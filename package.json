{
  "name": "reclaim-city",
  "version": "7.14.0",
  "private": true,
  "type": "module",
  "scripts": {
    "brokers:validate": "node research/data-brokers/build/validate.js",
    "brokers:import": "node research/data-brokers/build/import-registry.js",
    "brokers:check-urls": "node research/data-brokers/build/check-urls.js",
    "brokers:export": "node research/data-brokers/build/export.js",
    "brokers:layout": "node research/data-brokers/build/layout.js",
    "dev": "npx serve src -l 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:collective": "npm --prefix collective/service ci --no-audit --no-fund --silent && npm --prefix collective/service test && cd collective/job && python3 -m unittest discover -s tests -p 'test_run.py'",
    "test:collective:sql": "cd collective/job/tests && RC_TEST_PG=local python3 -m unittest"
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  }
}
